{"states": {"alabama": {"dds_name": "Alabama Disability Determination Services", "dds_url": null, "legal_aid_name": "Legal Services Alabama", "legal_aid_url": "https://legalservicesalabama.org/", "phone": "800-292-8106", "state_note": "SSA lists Alabama's DDS under the state Department of Education, with offices in Birmingham and Mobile. An SSI approval in Alabama also brings Medicaid coverage.", "sources": ["https://www.ssa.gov/privacy/sorn/app_b.htm", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://legalservicesalabama.org/", "https://www.disabilityresources.org/alabama-guide-to-ssdi-and-ssi.html"]}, "alaska": {"dds_name": "Alaska Disability Determination Services", "dds_url": "http://labor.alaska.gov/dvr/dds.htm", "legal_aid_name": "Alaska Legal Services Corporation", "legal_aid_url": "https://www.alsc-law.org", "phone": "907-777-8100", "state_note": "Alaska has a single DDS office, in Anchorage, serving the whole state; it sits in the Division of Vocational Rehabilitation within the Department of Labor and Workforce Development.", "sources": ["http://labor.alaska.gov/dvr/dds.htm", "http://www.ssa.gov/disability/professionals/procontacts.htm", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://www.alsc-law.org/wp-content/uploads/2013/11/intake-Kenai-2014.pdf"]}, "arizona": {"dds_name": "Disability Determination Services Administration", "dds_url": null, "legal_aid_name": "Community Legal Services", "legal_aid_url": "https://clsaz.org/legal-practice-areas/public-benefits-unit/", "phone": "800-352-0409", "state_note": "Arizona's DDS is the Disability Determination Services Administration, a division of the Department of Economic Security; it also makes disability determinations for AHCCCS (Medicaid), and Arizona pays no state supplement on top of federal SSI.", "sources": ["http://www.ssa.gov/disability/professionals/procontacts.htm", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://www.disabilityresources.org/arizona-disability-benefits.html", "https://clsaz.org/legal-practice-areas/public-benefits-unit/"]}, "arkansas": {"dds_name": "Arkansas Disability Determination for SSA", "dds_url": "https://www.arkansas.gov/ddssa/about.html", "legal_aid_name": "Center for Arkansas Legal Services", "legal_aid_url": "http://arkansaslegal.org/", "phone": "501-682-3030", "state_note": "Arkansas has a single DDS office, in Little Rock. SSI recipients in Arkansas automatically receive full Medicaid.", "sources": ["https://www.ssa.gov/privacy/sorn/app_b.htm", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://www.nolo.com/legal-encyclopedia/arkansas-disability-benefits-social-security-disability-insurance-ssi.html", "http://arkansaslegal.org/"]}, "california": {"dds_name": "Disability Determination Service Division", "dds_url": null, "legal_aid_name": "Disability Rights California", "legal_aid_url": "https://www.disabilityrightsca.org/publications/the-pabss-program-protection-advocacy-for-beneficiaries-of-social-security", "phone": null, "state_note": "California's DDS is the Disability Determination Service Division within the California Department of Social Services. California adds a State Supplementary Payment (SSP) on top of federal SSI, administered by SSA.", "sources": ["https://www.ssa.gov/privacy/sorn/app_b.htm", "http://www.ssa.gov/disability/professionals/procontacts.htm", "http://cdss.ca.gov/inforesources/ssi-ssp", "https://www.disabilityrightsca.org/publications/the-pabss-program-protection-advocacy-for-beneficiaries-of-social-security"]}, "colorado": {"dds_name": "Colorado Disability Determination Services", "dds_url": "https://cdhs.colorado.gov/dds", "legal_aid_name": "Colorado Legal Services", "legal_aid_url": "https://www.coloradolegalservices.org/", "phone": "303-368-4100", "state_note": "Colorado's DDS is a division of the Colorado Department of Human Services' Office of Adult, Aging and Disability Services, located in Aurora, and decides about 40,000 claims per year.", "sources": ["https://cdhs.colorado.gov/dds", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://www.nolo.com/legal-encyclopedia/colorado-disability-benefits-social-security-disability-insurance-ssi.html", "https://www.jcmh.org/wp-content/uploads/Legal-Disabilities.pdf"]}, "connecticut": {"dds_name": "Disability Determination Services", "dds_url": "https://portal.ct.gov/ads/about-us/disability-determination-services", "legal_aid_name": "Connecticut Legal Services", "legal_aid_url": "https://ctlegal.org/", "phone": "860-466-6100", "state_note": "Connecticut's DDS sits in the Department of Aging and Disability Services, Bureau of Rehabilitation Services. Connecticut also has a State Supplement program that can add cash assistance for people who are disabled or over 65.", "sources": ["https://portal.ct.gov/ads/about-us/disability-determination-services", "http://www.ssa.gov/disability/professionals/procontacts.htm", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://ctlawhelp.org/files/pamphlets/benefits_work/ssi-ssdi-EN-ltr.pdf"]}, "delaware": {"dds_name": "Delaware Disability Determination Services", "dds_url": "https://labor.delaware.gov/divisions/dvr/disability-determination/", "legal_aid_name": "Community Legal Aid Society, Inc.", "legal_aid_url": "https://www.declasi.org/legal-services/disability-legal-services/", "phone": "302-324-7600", "state_note": "Delaware's DDS is part of the Division of Vocational Rehabilitation in the Department of Labor, and it is the only DDS office in the state, located in New Castle.", "sources": ["https://labor.delaware.gov/divisions/dvr/", "https://labor.delaware.gov/divisions/dvr/disability-determination/", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://www.declasi.org/legal-services/disability-legal-services/"]}, "florida": {"dds_name": "Division of Disability Determinations", "dds_url": "https://www.floridahealth.gov/individual-family-health/disability-rehabilitation/disability-determinations/", "legal_aid_name": "Florida Legal Services, Inc.", "legal_aid_url": null, "phone": "800-499-6590", "state_note": "Florida's Division of Disability Determinations is run by the Florida Department of Health, and it also decides medical eligibility for Florida's Medically Needy Program. SSI recipients in Florida are automatically enrolled in Medicaid.", "sources": ["https://www.floridahealth.gov/individual-family-health/disability-rehabilitation/disability-determinations/", "https://www.floridahealth.gov/individual-family-health/disability-rehabilitation/disability-determinations/area-offices/", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://www.nolo.com/legal-encyclopedia/florida-disability-social-security-disability-insurance-ssi.html"]}, "georgia": {"dds_name": "Disability Adjudication Services", "dds_url": "https://gvs.georgia.gov/get-know-us/resources", "legal_aid_name": null, "legal_aid_url": null, "phone": "855-953-5841", "state_note": "Georgia does not call its agency DDS; Disability Adjudication Services (DAS) is a division of the Georgia Vocational Rehabilitation Agency, with offices in Stone Mountain, Athens, Savannah, Dalton, and Thomasville.", "sources": ["https://gvs.georgia.gov/get-know-us/resources", "https://www.disabilityresources.org/directory-of-disability-determination-services-dds-offices.html", "https://pamms.dhs.ga.gov/dfcs/tanf/appendix-e/"]}}}
